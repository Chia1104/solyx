{
  "name": "solyx",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "prepare": "vp config --no-agent",
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev:desktop": "vp run @solyx/desktop#dev",
    "build:desktop": "vp run @solyx/desktop#build",
    "dev:website": "vp run @solyx/website#dev",
    "build:website": "vp run @solyx/website#build",
    "deploy:website": "vp run @solyx/website#deploy"
  },
  "devDependencies": {
    "@chiastack/oxlint": "catalog:lint",
    "@types/node": "catalog:",
    "fallow": "catalog:lint",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
