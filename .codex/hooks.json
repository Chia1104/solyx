{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"$(git rev-parse --show-toplevel 2>/dev/null)\" && [ -f \"$d/.codex/hooks/fallow-gate.sh\" ] && cd \"$d\" && exec ./.codex/hooks/fallow-gate.sh; exit 0"
          }
        ]
      }
    ]
  }
}
