<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- V8 compiles JavaScript into executable memory. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- An ad-hoc signature carries no team ID, so library validation would refuse Electron's own
         frameworks, and the broker SDK the user downloads is signed by its vendor, not by us. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
  </dict>
</plist>
