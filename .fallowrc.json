{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "packages/*/scripts/*.ts",
    "packages/*/tests/fixtures/*.mjs",
    "apps/website/{shaders,void}.config.ts"
  ],
  "dynamicallyLoaded": ["apps/website/content/**/*.mdx"],
  "ignorePatterns": ["tools/oxlint/**"],
  "ignoreDependencies": ["@oxlint/plugins", "@fontsource-variable/noto-sans-tc"]
}
